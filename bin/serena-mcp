#!/usr/bin/env python3
"""Host-facing MCP stdio launcher; all diagnostics go to stderr."""
import argparse
import os
import sys
from poclib import compose, environment, load, require_running


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', default='dev', help='Disposable workspace id (default: dev)')
    args, extra = parser.parse_known_args()
    if extra[:1] == ['--']:
        extra = extra[1:]
    data = load(args.run)
    require_running(data)
    command = compose(data, 'exec', '-T', '-w', '/app', 'php', 'serena', 'start-mcp-server',
                      '--project', '/app', '--transport', 'stdio', '--agent-interface', 'REPL',
                      '--enable-web-dashboard', 'false', '--open-web-dashboard', 'false',
                      '--enable-gui-log-window', 'false', *extra)
    os.execvpe(command[0], command, environment(data))


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, ValueError, OSError) as exc:
        print(f'serena-mcp: {exc}', file=sys.stderr)
        sys.exit(3)
