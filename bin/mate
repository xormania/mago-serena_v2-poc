#!/usr/bin/env python3
"""Run installed Mate in an explicitly selected disposable container workspace."""
import argparse
import sys

from matelib import invoke, selected


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', required=True)
    parser.add_argument('argv', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
    if not argv:
        parser.error('Supply Mate arguments after --, for example tools:list --format=json')
    return invoke(selected(args.run), argv)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, ValueError, AssertionError, OSError) as exc:
        print(f'mate: {exc}', file=sys.stderr)
        sys.exit(3)
