#!/usr/bin/env python3
"""Build, exercise and inspect the Serena REPL + Mago PoC."""
import argparse
import hashlib
import os
import shutil
import json
from pathlib import Path
import subprocess
import sys
import time

from poclib import ROOT, compose, docker, environment, execute, load, metadata, new_id, prepare, require_running, run, source_integrity, start, stop


sys.path.insert(0, str(ROOT/'tests/integration'))
from evidence import REQUIRED, check_record, digest, make_plan, result_document, validate, write_json, seal_artifacts, verify_artifacts, validate_runtime


def fast(evidence=None):
    python = ROOT/'.venv/bin/python'
    if not python.is_file():
        raise RuntimeError('Run uv sync --frozen --python 3.12 before fast tests')
    env = {**os.environ}
    if evidence:
        env['POC_FAST_EVIDENCE'] = str(evidence)
    return run([str(python), str(ROOT/'tests/fast/run.py')], env=env).returncode


def capture_identity(data, source):
    evidence = Path(data['evidence'])
    response = execute(data, 'python', '/opt/poc/docker/executed_identity.py', capture_output=True, text=True, check=False)
    (evidence/'executed-identity.json').write_text(response.stdout)
    (evidence/'executed-identity.stderr').write_text(response.stderr)
    assert response.returncode == 0, f'Runtime identity failed; see {evidence}/executed-identity.stderr'
    actual = json.loads((evidence/'executed-identity.json').read_text())
    assert actual['run_id'] == data['run_id'] and actual['attempt_id'] == '1'
    prefixes = ('adapter/src/', 'tests/', 'docker/', 'config/', 'fixtures/', 'patches/')
    explicit = ('uv.lock', 'pyproject.toml', 'adapter/pyproject.toml', 'toolchain.lock.json')
    expected = {p:row['sha256'] for p,row in source['source_manifest'].items() if p.startswith(prefixes) or p in explicit}
    changed = sorted(path for path in actual['installed_files'].keys() | expected.keys()
                     if actual['installed_files'].get(path) != expected.get(path))
    assert not changed, f'Installed code/file inventory differs from checkout: {changed}; rebuild image'
    assert actual['installed_adapter']['sha256'] == expected['adapter/src/serena_mago/server.py']
    validate_runtime(actual, source)
    container = subprocess.check_output(compose(data, 'ps', '-q', 'php'), env=environment(data), text=True).strip()
    inspected = json.loads(subprocess.check_output([docker(), 'inspect', '--format', '{{json .Image}}', container], text=True))
    image = json.loads(subprocess.check_output([docker(), 'image', 'inspect', inspected], text=True))[0]
    identity = {'container_id':container, 'image_id':inspected, 'repo_digests':image.get('RepoDigests', []),
                'created':image['Created'], 'architecture':image['Architecture'], 'installed_files_checked':len(expected)}
    write_json(evidence/'image-identity.json', identity)
    return identity


def report(run_id):
    path = ROOT / 'artifacts' / run_id / 'results.json'
    if not path.exists():
        raise RuntimeError(f'No results recorded for {run_id}')
    result = json.loads(path.read_text())
    plan_path = ROOT/'workspaces'/run_id/'trusted/run-plan.json'
    if not plan_path.exists():
        # Evidence survives workspace purge, including the immutable run plan copy.
        plan_path = path.parent/'run-plan.json'
    plan = json.loads(plan_path.read_text())
    assert plan['run_id'] == run_id, 'Report belongs to another run'
    metadata_record = json.loads((path.parent/'metadata.json').read_text())
    assert digest(metadata_record) == plan['context_sha256'], 'Metadata is stale or modified'
    validate(result, plan, require_pass=False)
    for check in result['checks']:
        print(f"{check['status']:14} {check['name']}: {check.get('assertion', '')}")
    print(f"Evidence: {path.parent}")
    validate(result, plan)
    verify_artifacts(path.parent, ROOT/'artifacts'/(run_id+'-b'), result, metadata_record)
    return 0


def test(run_prefix="test"):
    from verifier import snapshot, save_snapshot, expected_suite, verify_suite
    run_id = new_id(run_prefix)
    a, b = prepare(run_id), prepare(run_id + '-b')
    evidence = Path(a['evidence'])
    source = metadata(a)
    plan = make_plan(run_id, source)
    write_json(evidence/'metadata.json', source)
    write_json(evidence/'run-plan.json', plan)
    for data in (a, b):
        write_json(Path(data['trusted'])/'run-plan.json', plan)
    checks = {name: check_record(plan, name) for name in REQUIRED}
    evidence_digest = None
    def save():
        value = result_document(plan, list(checks.values()))
        if evidence_digest:
            value['evidence_manifest_sha256'] = evidence_digest
        write_json(evidence/'results.json', value)
    def record(name, function, assertion):
        started = time.monotonic()
        assert checks[name]['status'] == 'not_exercised', f'Duplicate step {name}'
        try:
            detail = function()
            checks[name] = check_record(plan, name, 'pass', assertion, elapsed_s=round(time.monotonic()-started, 3))
            if detail is not None:
                checks[name]['detail'] = detail
        except Exception as exc:
            checks[name] = check_record(plan, name, 'fail', str(exc), elapsed_s=round(time.monotonic()-started, 3))
            raise
        finally:
            with (evidence/'step-attempts.jsonl').open('a') as ledger:
                ledger.write(json.dumps({**checks[name], 'step':name, 'step_attempt':1})+'\n')
            save()
    def phpunit(data):
        # Listing comes only from the fresh, hash-verified fixture before any semantic edit.
        execute(data, 'php', 'vendor/bin/phpunit', '--configuration', 'phpunit.dist.xml',
                '--list-tests-xml', '/evidence/expected-tests.xml', log=Path(data['evidence'])/'list-tests.log')
        inventory = expected_suite(Path(data['evidence'])/'expected-tests.xml', ROOT/'app')
        write_json(Path(data['trusted'])/'expected-suite.json', inventory)
        shutil.copy2(Path(data['trusted'])/'expected-suite.json', Path(data['evidence'])/'expected-suite.json')
        execute(data, 'php', 'vendor/bin/phpunit', '--configuration', 'phpunit.dist.xml', '--log-junit',
                '/evidence/phpunit.xml', log=Path(data['evidence'])/'phpunit.log')
        return verify_suite(inventory, Path(data['evidence'])/'phpunit.xml')
    def identity():
        identities = [capture_identity(data, source) for data in (a,b)]
        assert identities[0]['image_id'] == identities[1]['image_id'], 'Fresh workspaces use different images'
        return identities
    def baseline():
        for data in (a, b):
            # First activation expands project.yml and creates .serena/.gitignore.
            # Seal these known generated files instead of excluding configuration.
            execute(data, 'python', '/opt/poc/tests/integration/prime_project.py', log=Path(data['evidence'])/'baseline-mcp.log')
            save_snapshot(snapshot(data['app']), Path(data['trusted'])/'application.json', app_root=data['app'])
            shutil.copy2(Path(data['trusted'])/'application.json', Path(data['evidence'])/'application-baseline.json')
        return {data['run_id']:{p:hashlib.sha256((Path(data['trusted'])/p).read_bytes()).hexdigest()
                               for p in ('application.json','expected-suite.json')} for data in (a,b)}
    save()
    try:
        record('fast_tests', lambda: fast(evidence/'fast'), 'Deterministic properties, verifier regressions, evidence and mocked Jev tests passed')
        record('source_integrity', source_integrity, 'Original application files match upstream checksums plus declared fixture patch')
        for suffix, data in (('a', a), ('b', b)):
            record('setup_'+suffix, lambda d=data: start(d, validate_image=lambda selected: capture_identity(selected, source)), 'Verified image; fresh independent app, database, vendor tree and state; HTTP 200')
        record('executed_identity', identity, 'Installed adapter, harness, verifier, locks and actual container images match recorded source')
        for suffix, data in (('a', a), ('b', b)):
            record('phpunit_'+suffix, lambda d=data: phpunit(d), 'Exact original test identities and datasets pass without skips')
        record('application_checks', lambda: execute(a, '/opt/poc/docker/check', log=evidence/'application-checks.log').returncode,
               'Composer, Symfony resource linters and service/entity validation pass; PHP quality uses the separate Mago slice')
        record('trusted_baseline', baseline, 'Complete manifests and test inventories sealed before semantic operations')
        result = execute(a, 'python', '/opt/poc/tests/integration/run.py', log=evidence/'integration.log', check=False)
        core = json.loads((evidence/'integration-results.json').read_text())
        validate(core, plan, integration=True, require_pass=False)
        for check in core['checks']:
            checks[check['name']] = check
        save()
        validate(core, plan, integration=True)
        assert result.returncode == 0, f'Integration exit {result.returncode} contradicts results'
        def isolation():
            before = (Path(b['app'])/'data/database_test.sqlite').read_bytes()
            stop(a)
            require_running(b)
            assert before == (Path(b['app'])/'data/database_test.sqlite').read_bytes()
        record('workspace_isolation', isolation, 'Stopping A preserves running B and its distinct database')
        record('baseline_unchanged', source_integrity, 'Acceptance did not rewrite checked-in application files')
    except Exception as exc:
        write_json(evidence/'orchestration-error.json', {'type':type(exc).__name__, 'message':str(exc)})
        for name, row in checks.items():
            if row['status'] == 'not_exercised' and name != 'cleanup':
                checks[name] = check_record(plan, name, 'blocked', 'Earlier required step failed; see orchestration-error.json')
    finally:
        def cleanup():
            failures = []
            for data in (a,b):
                try:
                    run(compose(data, 'logs', '--no-color'), env=environment(data), log=Path(data['evidence'])/'container.log', check=False)
                    stop(data)
                except Exception as exc:
                    failures.append(str(exc))
                    write_json(Path(data['evidence'])/'cleanup-error.json', {'error':str(exc)})
            assert not failures, f'Cleanup failed: {failures}'
        try:
            record('cleanup', cleanup, 'Both owned Compose projects stopped; evidence and trusted baselines retained')
        except Exception:
            pass  # The failed required cleanup row is already persisted and prevents a pass.
        write_json(evidence/'separate-runs.json', {'model_driven_acceptance':'not_exercised_after_hardening',
                   'live_jev':'not_exercised; CI-only, pending activation'})
        evidence_digest = seal_artifacts(evidence, Path(b['evidence']))
        save()
        (evidence/'report.txt').write_text('\n'.join(f"{x['status']}: {x['name']} — {x.get('assertion', '')}" for x in checks.values())+'\n')
    return report(run_id)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    up = sub.add_parser('up', help='Build/start and provision the selected development workspace')
    up.add_argument('--run', default='dev')
    up.add_argument('--no-build', action='store_true')
    doctor = sub.add_parser('doctor', help='Check Docker, fixture, runtime and selected backend')
    doctor.add_argument('--run', default='dev')
    sub.add_parser('fast', help='Run deterministic property/verifier/evidence/mocked-provider tests without Docker')
    acceptance = sub.add_parser('test', help='Run two isolated Demo baselines and the real MCP/LSP acceptance matrix')
    acceptance.add_argument('--run-prefix', default='test', help='Prefix for task-owned disposable runs')
    mate_prepare = sub.add_parser('mate-prepare', help='Install the locked inspection overlay and refresh dev metadata')
    mate_prepare.add_argument('--run', required=True)
    mago = sub.add_parser('mago', help='Run Mago with explicit configuration in the selected workspace')
    mago.add_argument('--run', required=True)
    mago.add_argument('argv', nargs=argparse.REMAINDER)
    enriched = sub.add_parser('mago-enriched', help='Analyze with fresh compiled Symfony wiring through Mago')
    enriched.add_argument('--run', required=True)
    enriched.add_argument('--symbol', action='append', default=[], help='Observe this class constructor in Mago (repeatable)')
    enriched.add_argument('--extension-off', action='store_true', help='Explicit comparison without wiring contribution')
    enriched.add_argument('argv', nargs=argparse.REMAINDER)
    quality = sub.add_parser('quality', help='Record native Mago analysis, lint and scoped formatting results')
    quality.add_argument('--run', required=True)
    slice1 = sub.add_parser('slice1', help='Run the combined Mago-first service, Symfony wiring and behavior proof')
    slice1.add_argument('--run', help='Owned workspace id; defaults to a fresh isolated run')
    slice1.add_argument('--keep-running', action='store_true')
    slice2 = sub.add_parser('slice2', help='Generate and verify the disposable app:tags:count feature')
    slice2.add_argument('--run', help='Owned workspace id; defaults to a fresh isolated run')
    slice2.add_argument('--keep-running', action='store_true')
    sub.add_parser('agent-task', help='Prepare a fresh real-agent workspace and exact MCP configuration')
    verify = sub.add_parser('verify-agent', help='Independently verify an agent run, its MCP transcript and original tests')
    verify.add_argument('run_id')
    ex = sub.add_parser('exec', help='Run an argv command in the selected php service')
    ex.add_argument('--run', default='dev')
    ex.add_argument('argv', nargs=argparse.REMAINDER)
    rep = sub.add_parser('report', help='Print recorded results; absent evidence is never a pass')
    rep.add_argument('run_id')
    down = sub.add_parser('down', help='Stop only this checkout’s selected environment')
    down.add_argument('--run', default='dev')
    down.add_argument('--purge', action='store_true', help='Also delete that disposable workspace; retain evidence')
    args = parser.parse_args()
    if args.command == 'up':
        data = prepare(args.run, port=8000 if args.run == 'dev' else 0)
        start(data, build=not args.no_build)
        print(f"Ready: host {data['app']} → container /app; ./bin/serena-mcp --run {args.run}")
    elif args.command == 'doctor':
        print(f'Fixture integrity: {source_integrity()} upstream files checked')
        run([docker(), 'info', '--format', 'Docker {{.ServerVersion}}'])
        data = load(args.run)
        require_running(data)
        print(f"Compose project: {data['project']}\nApplication: {data['app']} → /app\nState: {data['state']}")
        execute(data, 'cat', '/opt/toolchain-runtime.json')
        execute(data, 'python', '-c', "from solidlsp.ls_config import LanguageServerRegistry; x=LanguageServerRegistry.get_instance().resolve('mago'); print('Backend:', x.get_key(), x.get_ls_class().__module__)")
        execute(data, 'composer', 'check-platform-reqs')
    elif args.command == 'fast':
        return fast()
    elif args.command == 'test':
        return test(args.run_prefix)
    elif args.command == 'mate-prepare':
        from matelib import prepare_mate, selected
        prepare_mate(selected(args.run))
    elif args.command == 'mago':
        from magolib import invoke, selected
        argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
        if not argv:
            raise ValueError('Supply Mago arguments after --')
        return invoke(selected(args.run), argv)
    elif args.command == 'mago-enriched':
        from magolib import invoke_enriched, selected
        argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
        if not argv:
            raise ValueError('Supply Mago analyze arguments after --')
        return invoke_enriched(selected(args.run), argv, symbols=args.symbol,
                               wiring_enabled=not args.extension_off)
    elif args.command == 'quality':
        from magolib import quality, selected
        result = quality(selected(args.run))
        print(json.dumps(result, indent=2))
        return max(row['exit'] if row['exit'] >= 0 else 128-row['exit'] for row in result['commands'])
    elif args.command in ('slice1', 'slice2'):
        # Semantic replay is host-side and needs the same locked MCP packages as
        # fast tests. Other orchestration commands deliberately use stdlib only.
        if Path(sys.prefix).resolve() != (ROOT/'.venv').resolve():
            python = ROOT/'.venv/bin/python'
            if not python.is_file():
                raise RuntimeError('Run uv sync --frozen --python 3.12 before '+args.command)
            os.execv(str(python), [str(python), str(ROOT/'bin/poc'), *sys.argv[1:]])
        if args.command == 'slice1':
            from slice1lib import run_slice
        else:
            from slice2lib import run_slice
        return run_slice(args.run, keep_running=args.keep_running, capture_identity=capture_identity)
    elif args.command == 'report':
        return report(args.run_id)
    elif args.command == 'down':
        stop(load(args.run), args.purge)
    elif args.command == 'exec':
        argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
        if not argv:
            raise ValueError('Supply a command after --')
        data = load(args.run)
        require_running(data)
        return execute(data, *argv, check=False).returncode
    elif args.command == 'verify-agent':
        data = load(args.run_id)
        capture_identity(data, json.loads((Path(data['evidence'])/'metadata.json').read_text()))
        sys.path.insert(0, str(ROOT/'tests/integration'))
        from verifier import load_snapshot, verify_rename, verify_suite
        changed = verify_rename(load_snapshot(Path(data['trusted'])/'application.json'), data['app'], data['evidence'])
        execute(data, 'php', 'vendor/bin/phpunit', '--configuration', 'phpunit.dist.xml', '--log-junit', '/evidence/agent-phpunit.xml', log=Path(data['evidence'])/'agent-phpunit.log')
        verify_suite(json.loads((Path(data['trusted'])/'expected-suite.json').read_text()), Path(data['evidence'])/'agent-phpunit.xml')
        execute(data, 'python', '/opt/poc/tests/integration/verify_agent.py', log=Path(data['evidence'])/'agent-verification.log')
        source_integrity()
        print(f'Agent verification passed: {changed}; evidence: {data["evidence"]}')
    elif args.command == 'agent-task':
        from verifier import expected_suite, snapshot, save_snapshot, verify_suite
        fast()
        data = prepare(new_id('agent'))
        start(data)
        source = metadata(data)
        capture_identity(data, source)
        execute(data, 'php', 'vendor/bin/phpunit', '--configuration', 'phpunit.dist.xml', '--list-tests-xml',
                '/evidence/expected-tests.xml', log=Path(data['evidence'])/'list-tests.log')
        inventory = expected_suite(Path(data['evidence'])/'expected-tests.xml', ROOT/'app')
        write_json(Path(data['trusted'])/'expected-suite.json', inventory)
        execute(data, 'php', 'vendor/bin/phpunit', '--configuration', 'phpunit.dist.xml', '--log-junit',
                '/evidence/baseline-phpunit.xml', log=Path(data['evidence'])/'baseline-phpunit.log')
        verify_suite(inventory, Path(data['evidence'])/'baseline-phpunit.xml')
        execute(data, 'python', '/opt/poc/tests/integration/prime_project.py', log=Path(data['evidence'])/'baseline-mcp.log')
        save_snapshot(snapshot(data['app']), Path(data['trusted'])/'application.json', app_root=data['app'])
        # Index the exact starting sources so an agent can inspect ordinary git
        # diffs without creating commits or staging generated state/dependencies.
        run(['git','init','--initial-branch=poc-fixture',data['app']], capture_output=True)
        originals = json.loads((ROOT/'fixtures/upstream.sha256.json').read_text())
        existing = [path for path in originals if Path(data['app'],path).is_file()]
        run(['git','-C',data['app'],'add','--',*existing], capture_output=True)
        instructions = (ROOT/'docs/agent-task.txt').read_text()
        config = {'mcpServers': {'serena': {'command': str(ROOT/'bin/serena-mcp'), 'args': ['--run', data['run_id']]}}}
        (Path(data['evidence'])/'agent-task.txt').write_text(instructions)
        (Path(data['evidence'])/'mcp-config.json').write_text(json.dumps(config,indent=2))
        (Path(data['evidence'])/'metadata.json').write_text(json.dumps(source,indent=2))
        print(instructions + '\n' + json.dumps(config,indent=2))
        print(f"Run container commands: {ROOT/'bin/poc'} exec --run {data['run_id']} -- php vendor/bin/phpunit")
        print(f"Workspace: {data['app']}\nEvidence: {data['evidence']}\nAfter the session: ./bin/poc verify-agent {data['run_id']}")
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, ValueError, AssertionError, subprocess.SubprocessError, OSError) as exc:
        print(f'poc: {exc}', file=sys.stderr)
        sys.exit(3 if len(sys.argv) > 1 and sys.argv[1] == 'mago-enriched' else 1)
