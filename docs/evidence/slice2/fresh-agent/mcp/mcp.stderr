s.edit.replace_symbol_body("TagsCountCommand", "src/Command/TagsCountCommand.php", "#[AsCommand(name: 'app:tags:count', description: 'Count persisted tags.')]\nfinal class TagsCountCommand extends Command\n{\n    public function __construct(private readonly TagRepository $tags)\n    {\n        parent::__construct();\n    }\n\n    protected function execute(InputInterface $input, OutputInterface $output): int\n    {\n        $output->writeln(\\sprintf('Tag count: %d', $this->tags->count([])));\n\n        return Command::SUCCESS;\n    }\n}")
