<?php

use Symfony\Component\DependencyInjection\Loader\Configurator\ContainerConfigurator;

return static function (ContainerConfigurator $container): void {
    $container->parameters()
        ->set('mate.invocation', __POC_INVOCATION__)
        ->set('mate.php_version', '8.5')
        // No fallback to the test/prod container when inspecting this dev run.
        ->set('ai_mate_symfony.cache_dir', ['inspection-dev' => '%mate.root_dir%/var/cache/dev'])
    ;
};
